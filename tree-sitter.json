{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [{
    "name": "astro",
    "camelcase": "Astro",
    "scope": "source.astro",
    "path": ".",
    "file-types": ["astro"],
    "injection-regex": "^astro$",
    "highlights": "queries/highlights.scm",
    "external-files": ["src/typescript_scanner.h"]
  }],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Astro grammar with native TypeScript syntax for source analysis",
    "authors": [{"name": "tree-sitter-astro contributors"}]
  },
  "bindings": {"rust": true, "c": true}
}
